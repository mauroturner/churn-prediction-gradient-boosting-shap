# The four secrets of airflow/docker-compose.yaml. Copy this file to airflow/.env (git-ignored) and give each one a value of your own: none has
# a default, and the compose file refuses to start while one is missing or empty. Generate them on your machine, for example:
#   CHURNRISK_DB_PASSWORD, CHURNRISK_JWT_SECRET, CHURNRISK_ADMIN_PASSWORD:
#     python -c "import secrets; print(secrets.token_hex(24))"
#   CHURNRISK_FERNET_KEY (32 bytes in URL-safe base64, what Airflow's Fernet key is):
#     python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# On Linux, add AIRFLOW_UID=<the output of id -u> as well (see docker-compose.yaml).
CHURNRISK_DB_PASSWORD=
CHURNRISK_FERNET_KEY=
CHURNRISK_JWT_SECRET=
CHURNRISK_ADMIN_PASSWORD=
